# ---------------------------------------------------------------------------
# Generated shop assets. `python tools/seed_db.py` rebuilds all of it, so
# committing it would mean every clone carries somebody else's shop and every
# demo run shows up as a diff.
# ---------------------------------------------------------------------------
data/covers/
data/figures/
data/books/
data/image_index.json
data/scans/
data/demo_shelf.png
data/shelf_annotated.png

# Face and voice samples are biometric data about real people. These never
# belong in a repository, not even a private one.
data/biometrics/

# Detector weights, fetched by `python tools/fetch_models.py`.
data/models/

# Superseded by the database, but left behind by the v1 tag on an old clone.
data/users.json
data/books.json
data/reviews.json
data/transactions.json
data/events.json

# NOT ignored, deliberately: data/kb/ is the corpus the assistant retrieves
# from. It is written by hand, no script regenerates it, and without it RAG
# has nothing to answer from on a fresh clone.
